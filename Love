    <script>
      // --- Page Navigation Logic ---
      const allPages = document.querySelectorAll('.page');
      const navLinks = document.querySelectorAll('.nav-link');

      function showPage(targetId) {
        // Remove 'active' class from all pages
        allPages.forEach(page => page.classList.remove('active'));

        // Get the target page and add 'active' class
        const targetPage = document.querySelector(targetId);
        if (targetPage) {
          targetPage.classList.add('active');
        }
      }

      // Listen for clicks on all navigation links
      navLinks.forEach(link => {
        link.addEventListener('click', function(e) {
          // If the link is the special 'move-random' link, let the random function handle it
          if (this.id === 'move-random') {
            return; // Exit here, don't change the page
          }
          e.preventDefault(); // Stop the default anchor jump
          const targetId = this.getAttribute('href');
          showPage(targetId);
        });
      });

      // --- Random Moving Button Logic ---
      const moveRandom = document.querySelector("#move-random");

      function moveRandomEl(elm) {
        // Set position to absolute to allow 'top' and 'left' to position it anywhere
        elm.style.position = "absolute";
        
        // Calculate new random position (between 5% and 95% to keep it visible)
        elm.style.top = Math.floor(Math.random() * 90 + 5) + "%";
        elm.style.left = Math.floor(Math.random() * 90 + 5) + "%";
      }
      
      // Desktop: Moves on mouse over
      moveRandom.addEventListener("mouseenter", function (e) {
        moveRandomEl(e.target);
      });

      // Mobile: Moves on touch start (for touchscreens)
      moveRandom.addEventListener("touchstart", function (e) {
        e.preventDefault(); // Prevent touch from triggering unwanted events
        moveRandomEl(e.target);
      });
      
    </script>
